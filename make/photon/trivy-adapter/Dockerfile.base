FROM dhi.io/debian-base:trixie-debian13-dev

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl passwd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10000 scanner \
    && useradd --no-log-init --create-home --system --gid 10000 --uid 10000 scanner \
    && mkdir -p /etc/pki/tls/certs /home/scanner/bin \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt
