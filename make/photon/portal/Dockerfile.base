FROM dhi.io/nginx:1.31.6-debian13-dev@sha256:8f8a690387d75205568103d234f2b6a348f6ee8183708de0e501cc3f8a5d5df0

RUN apt-get update && apt-get install -y --no-install-recommends curl passwd \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log \
    && groupmod --gid 10000 nginx && usermod --gid 10000 --uid 10000 --home /home/nginx --shell /bin/bash nginx \
    && chown -R nginx:nginx /etc/nginx
