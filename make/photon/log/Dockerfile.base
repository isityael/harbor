FROM dhi.io/debian-base:trixie-debian13-dev

RUN apt-get update && apt-get install -y --no-install-recommends cron rsyslog logrotate passwd tar gzip sudo net-tools \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/spool/rsyslog \
    && groupadd --system --gid 10000 syslog \
    && useradd --no-log-init --system --gid 10000 --uid 10000 \
        --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin syslog \
    && chage -M 99999 root
