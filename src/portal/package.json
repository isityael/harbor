{
    "name": "harbor",
    "version": "2.15.0",
    "description": "Harbor UI with Clarity",
    "angular-cli": {},
    "scripts": {
        "postinstall": "node scripts/convert-yaml-to-json.js && ng-swagger-gen -i ng-swagger-gen/swagger.json -o ng-swagger-gen && node scripts/fix-generated-typescript.js && node scripts/delete-swagger-json.js",
        "start": "node --max_old_space_size=2048 ./node_modules/@angular/cli/bin/ng serve --ssl true --host 0.0.0.0",
        "start:prod": "node --max_old_space_size=2048 ./node_modules/@angular/cli/bin/ng serve --ssl true --host 0.0.0.0 --configuration production",
        "start_default_port": "node --max_old_space_size=2048 ./node_modules/@angular/cli/bin/ng serve --ssl true --host 0.0.0.0 --port 443 --disable-host-check",
        "lint": "ng lint",
        "lint_fix": "ng lint --fix",
        "lint:style": "npx stylelint \"**/*.scss\"",
        "lint_fix:style": "npx stylelint \"**/*.scss\" --fix",
        "test": "node --max_old_space_size=2048 ./node_modules/@angular/cli/bin/ng test --code-coverage",
        "test:watch": "ng test --code-coverage --watch",
        "test:debug": "ng test --code-coverage --source-map false",
        "test:chrome": "ng test --code-coverage --browsers Chrome",
        "test:headless": "ng test --watch=false --no-progress --code-coverage --browsers=ChromeHeadlessNoSandbox",
        "test:chrome-debug": "ng test --code-coverage --browsers Chrome --watch",
        "e2e": "ng e2e",
        "build": "ng build --aot",
        "release": "ng build --configuration production",
        "build-mock-api-server": "tsc -p server",
        "mock-api-server": "npm run build-mock-api-server && node server/dist/server/src/mock-api.js",
        "generate-build-timestamp": "node scripts/generate-build-timestamp.js",
        "i18n:check": "node scripts/find-missing-i18n.js"
    },
    "private": true,
    "packageManager": "npm@12.0.1",
    "engines": {
        "node": ">=26.5.0",
        "npm": ">=12.0.1"
    },
    "dependencies": {
        "@angular/animations": "22.0.7",
        "@angular/cdk": "22.0.5",
        "@angular/common": "22.0.7",
        "@angular/compiler": "22.0.7",
        "@angular/core": "22.0.7",
        "@angular/forms": "22.0.7",
        "@angular/localize": "22.0.7",
        "@angular/platform-browser": "22.0.7",
        "@angular/platform-browser-dynamic": "22.0.7",
        "@angular/router": "22.0.7",
        "@clr/addons": "18.2.1",
        "@clr/angular": "18.2.1",
        "@clr/icons": "13.0.2",
        "@clr/ui": "18.2.1",
        "@ngx-translate/core": "18.0.0",
        "@ngx-translate/http-loader": "18.0.0",
        "cron-validator": "1.4.0",
        "echarts": "6.1.0",
        "js-yaml": "5.2.1",
        "marked": "18.0.6",
        "marked-katex-extension": "5.1.10",
        "ngx-clipboard": "16.0.0",
        "ngx-cookie": "6.0.1",
        "ngx-markdown": "22.0.0",
        "prismjs": "1.30.0",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "zone.js": "0.16.2"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "22.0.7",
        "@angular-eslint/builder": "22.1.0",
        "@angular-eslint/eslint-plugin": "22.1.0",
        "@angular-eslint/eslint-plugin-template": "22.1.0",
        "@angular-eslint/schematics": "22.1.0",
        "@angular-eslint/template-parser": "22.1.0",
        "@angular/cli": "22.0.7",
        "@angular/compiler-cli": "22.0.7",
        "angular-eslint": "22.1.0",
        "@cypress/schematic": "5.0.0",
        "@types/express": "5.0.6",
        "@types/jasmine": "6.0.0",
        "@types/node": "26.1.1",
        "@typescript-eslint/eslint-plugin": "8.64.0",
        "@typescript-eslint/parser": "8.64.0",
        "cypress": "15.18.1",
        "eslint": "10.7.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "express": "5.2.1",
        "https-proxy-agent": "9.1.0",
        "istanbul-lib-instrument": "6.0.3",
        "jasmine-core": "6.3.0",
        "jasmine-spec-reporter": "7.0.0",
        "karma": "6.4.4",
        "karma-chrome-launcher": "3.2.0",
        "karma-coverage": "2.2.1",
        "karma-jasmine": "5.1.0",
        "karma-jasmine-html-reporter": "2.2.0",
        "ng-swagger-gen": "2.3.1",
        "prettier": "3.9.5",
        "stylelint": "17.14.0",
        "stylelint-config-prettier-scss": "1.0.0",
        "stylelint-config-standard": "40.0.0",
        "stylelint-config-standard-scss": "17.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.64.0"
    },
    "overrides": {
        "yargs": "17.7.2"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.6": true,
        "cypress@15.18.1": true,
        "esbuild@0.27.7": true,
        "esbuild@0.28.1": true,
        "lmdb@3.5.4": true,
        "msgpackr-extract@3.0.4": true,
        "core-js": false,
        "fsevents": false
    }
}
