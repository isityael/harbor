{
    "name": "harbor-swagger-ui",
    "version": "2.10.0",
    "description": "Swagger UI for Harbor APIs",
    "packageManager": "npm@12.0.1",
    "engines": {
        "node": ">=26.5.0",
        "npm": ">=12.0.1"
    },
    "scripts": {
        "build": "webpack --config webpack.prod.js && mv dist/index.html dist/swagger-ui-index.html",
        "start": "webpack serve --open --config webpack.dev.js"
    },
    "dependencies": {
        "css-loader": "^7.1.4",
        "style-loader": "^4.0.0",
        "swagger-ui": "5.32.8"
    },
    "devDependencies": {
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "html-webpack-plugin": "^5.6.7",
        "webpack": "^5.108.4",
        "webpack-cli": "^7.2.1",
        "webpack-dev-server": "^6.0.0"
    },
    "overrides": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "allowScripts": {
        "@scarf/scarf@1.4.0": false,
        "@tree-sitter-grammars/tree-sitter-yaml@0.7.1": true,
        "core-js-pure@3.49.0": false,
        "tree-sitter-json@0.24.8": true,
        "tree-sitter@0.21.1": true,
        "tree-sitter@0.22.4": true
    }
}
