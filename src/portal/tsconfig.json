/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist/out-tsc",
        "sourceMap": true,
        "declaration": false,
        "strict": false,
        "experimentalDecorators": true,
        "moduleResolution": "bundler",
        "importHelpers": true,
        "target": "ES2022",
        "module": "es2020",
        "useDefineForClassFields": false,
        "paths": {
            "@harbor/translate-module": [
                "./src/app/shared/translate.module.ts"
            ],
            "ng-swagger-gen/*": ["./ng-swagger-gen/*"],
            "src/*": ["./src/*"]
        }
    },
    "exclude": ["cypress.config.ts"]
}
