{
    "compilerOptions": {
        "module": "node16",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2022",
        "noImplicitAny": true,
        "moduleResolution": "node16",
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": ".."
    },
    "include": ["src/**/*"]
}
