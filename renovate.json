{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:recommended",
    ":semanticCommits"
  ],
  "baseBranchPatterns": [
    "progressed"
  ],
  "goGetDirs": [
    "./lib/...",
    "./pkg/...",
    "./common/...",
    "./cmd/exporter"
  ],
  "postUpdateOptions": [
    "gomodTidyE"
  ],
  "labels": [
    "release-note/bump-version"
  ],
  "ignoreDeps": [
    "postgresql",
    "redis",
    "github.com/distribution/distribution",
    "github.com/docker/distribution",
    "github.com/go-asn1-ber/asn1-ber",
    "github.com/google/uuid",
    "github.com/opencontainers/go-digest",
    "github.com/robfig/cron/v3"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track registry distribution dependency overrides shared by release images and PR builds",
      "managerFilePatterns": [
        "/^build\\/docker\\/prepare-distribution\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=go depName=(?<depName>[^\\s]+)\\n[A-Z0-9_]+=(?<currentValue>v[^\\s]+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Track inline Go module overrides in the Trivy adapter image",
      "managerFilePatterns": [
        "/^build\\/docker\\/Dockerfile\\.trivy-adapter$/"
      ],
      "matchStrings": [
        "(?<depName>[A-Za-z0-9.-]+\\.[A-Za-z]+/[A-Za-z0-9._/-]+)@(?<currentValue>v[0-9][^\\s\\\\]*)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "description": "Disable digest pinning and updates for all Docker images",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "woodpecker"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "DHI rebuilds a tag in place to ship Debian security fixes, so dhi.io digest refreshes stay on (the shared base config resolves dhi.io and groups these as dhi base images)",
      "matchPackageNames": [
        "/^dhi\\.io//"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "harbor-db pairs an upgrade-source and a runtime PostgreSQL major with the entrypoint's \"15\" \"18\" arguments (.ci/test-db-image-pins.sh); a major move is a deliberate upgrade, never a Renovate bump",
      "matchPackageNames": [
        "dhi.io/postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Group Go module digest (pseudo-version) updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "enabled": false
    },
    {
      "description": "Kubernetes 0.37 uses structured-merge-diff/v6; newer kube-openapi requires v7. Lift this cap with the Kubernetes API migration.",
      "matchPackageNames": [
        "k8s.io/kube-openapi"
      ],
      "allowedVersions": "<=v0.0.0-20260821135717-be32def86098"
    },
    {
      "description": "The gopkg.in v1 module path cannot accept v2 tags; newer majors require an import migration.",
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "gopkg.in/square/go-jose.v1"
      ],
      "allowedVersions": "<2.0.0"
    },
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "One reviewed weekly dependency refresh, including majors, charts, images and tooling.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "additionalBranchPrefix": "",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": false
    }
  ],
  "ignorePaths": [
    "src/portal/**",
    "make/photon/**",
    "src/pkg/chart/testdata/**",
    "tools/migrate_chart/**"
  ],
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "prConcurrentLimit": 1,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  }
}
