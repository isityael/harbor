# Multi-stage Dockerfile for harbor-trivy-adapter built on DHI bases.
ARG GO_IMAGE=dhi.io/golang:1.27.3-alpine3.24-dev@sha256:2ceb813d69b9c82501323484e0c0ae612efde281f5dffce2a3d83a79a9c87304
ARG TRIVY_IMAGE=aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
ARG RUNTIME_IMAGE=dhi.io/alpine-base:3.24-alpine3.24@sha256:72525b95de76cbb53077d1afc12bf541846754477c4ce842cd3d9374a7af55bc
ARG TRIVY_ADAPTER_VERSION=v0.39.1

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS scanner-builder
ARG TRIVY_ADAPTER_VERSION
ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src
RUN git clone --depth 1 --branch "${TRIVY_ADAPTER_VERSION}" https://github.com/goharbor/harbor-scanner-trivy.git .
# Patch the adapter's networking and Redis dependencies while preserving its upstream
# go-containerregistry replacement and Docker API major version.
RUN go get golang.org/x/net@v0.61.0 golang.org/x/crypto@v0.58.0 \
    golang.org/x/sys@v0.49.0 golang.org/x/text@v0.43.0 \
    github.com/redis/go-redis/v9@v9.23.0
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -mod=mod -o /out/scanner-trivy cmd/scanner-trivy/main.go

FROM ${TRIVY_IMAGE} AS trivy-source

FROM ${RUNTIME_IMAGE}
ARG TRIVY_VERSION=v0.76.0

ENV HARBOR_CA_BUNDLE=/home/scanner/ca-bundle.crt \
    SSL_CERT_FILE=/home/scanner/ca-bundle.crt \
    TRIVY_VERSION=${TRIVY_VERSION}

USER 0
RUN mkdir -p /home/scanner/bin /home/scanner/.cache/trivy /home/scanner/.cache/reports /etc/harbor/ssl /harbor_cust_cert \
    && cp /etc/ssl/certs/ca-certificates.crt /home/scanner/ca-bundle.crt \
    && chown -R 10000:10000 /home/scanner /etc/harbor/ssl /harbor_cust_cert

COPY --from=trivy-source --chown=10000:10000 --chmod=0755 /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=scanner-builder --chown=10000:10000 --chmod=0755 /out/scanner-trivy /home/scanner/bin/scanner-trivy
COPY --chown=10000:10000 --chmod=0755 make/photon/common/install_cert.sh /home/scanner/
COPY --chown=10000:10000 --chmod=0755 make/photon/trivy-adapter/entrypoint.sh /home/scanner/

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/probe/healthy || \
        wget --no-check-certificate -q -O /dev/null https://localhost:8443/probe/healthy || exit 1

USER 10000:10000
ENTRYPOINT ["/home/scanner/entrypoint.sh"]
