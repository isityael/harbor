# Dockerfile for Harbor's nginx gateway built on a DHI nginx base.
ARG RUNTIME_IMAGE=dhi.io/nginx:1.31.6-debian13-dev@sha256:32e434084ff7e82629abc090c534fa0b02ebf1a7465f8029314bf9e95349c3a1

FROM ${RUNTIME_IMAGE}

USER 0
RUN apt-get update && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/nginx/logs /var/cache/nginx /var/log/nginx /run \
    && chown -R nginx:nginx /var/lib/nginx /var/cache/nginx /var/log/nginx /run

VOLUME ["/var/cache/nginx", "/var/log/nginx", "/run"]
STOPSIGNAL SIGQUIT

HEALTHCHECK CMD wget -q -O /dev/null http://localhost:8080 || exit 1

USER nginx
CMD ["nginx", "-g", "daemon off;"]
