# Dockerfile for Harbor's internal Valkey image built on a DHI Valkey base.
ARG RUNTIME_IMAGE=dhi.io/valkey:9.1.2-debian13-dev@sha256:0f9f1596060a5fac665a3cb004d298483eac70b39e93ab7c54251bd3c1c0790f

FROM ${RUNTIME_IMAGE}

USER 0
RUN mkdir -p /var/lib/redis \
    && chown -R 65532:65532 /var/lib/redis

VOLUME ["/var/lib/redis"]
WORKDIR /var/lib/redis

COPY --chown=65532:65532 --chmod=0755 make/photon/valkey/docker-healthcheck /usr/bin/docker-healthcheck
COPY --chown=65532:65532 make/photon/valkey/redis.conf /etc/redis.conf

HEALTHCHECK CMD ["docker-healthcheck"]
USER 65532:65532
CMD ["valkey-server", "/etc/redis.conf"]
