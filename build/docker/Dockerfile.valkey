# Dockerfile for Harbor's internal Valkey image built on a DHI Valkey base.
ARG RUNTIME_IMAGE=dhi.io/valkey:9.1.0-debian13

FROM ${RUNTIME_IMAGE}

USER root
RUN mkdir -p /var/lib/redis \
    && chown -R valkey:valkey /var/lib/redis

VOLUME ["/var/lib/redis"]
WORKDIR /var/lib/redis

COPY --chown=valkey:valkey --chmod=0755 make/photon/valkey/docker-healthcheck /usr/bin/docker-healthcheck
COPY --chown=valkey:valkey make/photon/valkey/redis.conf /etc/redis.conf

HEALTHCHECK CMD ["docker-healthcheck"]
USER valkey
CMD ["valkey-server", "/etc/redis.conf"]
