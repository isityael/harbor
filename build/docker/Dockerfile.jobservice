# Multi-stage Dockerfile for harbor-jobservice built from sm-moshi/harbor.
ARG GO_IMAGE=dhi.io/golang:1.26.4-alpine3.24-dev
ARG RUNTIME_IMAGE=dhi.io/alpine-base:3.24-alpine3.24

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS builder
ARG GITCOMMIT=unknown
ARG RELEASE_VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /harbor
COPY src/ ./src/
COPY api/ ./api/
COPY tools/swagger/templates/ ./tools/swagger/templates/

RUN go install github.com/go-swagger/go-swagger/cmd/swagger@v0.33.1 \
    && swagger generate server \
    --template-dir=tools/swagger/templates \
    --exclude-main \
    --additional-initialism=CVE \
    --additional-initialism=GC \
    --additional-initialism=OIDC \
    -f api/v2.0/swagger.yaml \
    -A harbor \
    --target src/server/v2.0

RUN cd src && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -mod=mod -o /out/harbor_jobservice \
    -ldflags "-w -s \
    -X github.com/goharbor/harbor/src/pkg/version.GitCommit=${GITCOMMIT} \
    -X github.com/goharbor/harbor/src/pkg/version.ReleaseVersion=${RELEASE_VERSION}" \
    ./jobservice

FROM ${RUNTIME_IMAGE}

ENV HARBOR_CA_BUNDLE=/harbor/ca-bundle.crt \
    SSL_CERT_FILE=/harbor/ca-bundle.crt

USER 0
RUN mkdir -p /harbor /var/log/jobs /etc/harbor/ssl /harbor_cust_cert \
    && cp /etc/ssl/certs/ca-certificates.crt /harbor/ca-bundle.crt \
    && chown -R 10000:10000 /harbor /var/log/jobs /etc/harbor/ssl /harbor_cust_cert

COPY --from=builder --chown=10000:10000 --chmod=0755 /out/harbor_jobservice /harbor/
COPY --chown=10000:10000 --chmod=0755 make/photon/jobservice/entrypoint.sh /harbor/
COPY --chown=10000:10000 --chmod=0755 make/photon/common/install_cert.sh /harbor/

VOLUME ["/var/log/jobs/"]

HEALTHCHECK --interval=30s --timeout=10s \
    CMD wget -q -O /dev/null http://localhost:8080/api/v1/stats || exit 1

WORKDIR /harbor/
USER 10000:10000
ENTRYPOINT ["/harbor/entrypoint.sh"]
