# Dockerfile for Harbor's internal PostgreSQL image built on a DHI PostgreSQL base.
ARG POSTGRES_15_IMAGE=dhi.io/postgres:15.19-debian13-dev@sha256:4bcfad9713b9706bd7115b3d2984b8d691eac7a67230c65a774b0ef9b91eeff7
ARG RUNTIME_IMAGE=dhi.io/postgres:18.6-debian13-dev@sha256:934071ebbde716cae249348d0b7cb23900328c751e9b11df03907dd26c7b3304

FROM ${POSTGRES_15_IMAGE} AS postgres15

FROM ${RUNTIME_IMAGE}

ENV PGDATA=/var/lib/postgresql/data

USER 0
RUN mkdir -p /var/lib/postgresql/data /docker-entrypoint-initdb.d \
    && chown -R postgres:postgres /var/lib/postgresql /docker-entrypoint-initdb.d

COPY --from=postgres15 /opt/postgresql/15 /opt/postgresql/15

COPY --chown=postgres:postgres --chmod=0755 make/photon/db/docker-entrypoint.sh /docker-entrypoint.sh
COPY --chown=postgres:postgres --chmod=0755 make/photon/db/initdb.sh /initdb.sh
COPY --chown=postgres:postgres --chmod=0755 make/photon/db/upgrade.sh /upgrade.sh
COPY --chown=postgres:postgres --chmod=0755 make/photon/db/docker-healthcheck.sh /docker-healthcheck.sh
COPY --chown=postgres:postgres make/photon/db/initial-registry.sql /docker-entrypoint-initdb.d/

VOLUME ["/var/lib/postgresql/data"]
ENTRYPOINT ["/docker-entrypoint.sh", "15", "18"]
HEALTHCHECK CMD ["/docker-healthcheck.sh"]

USER postgres
