# Multi-stage Dockerfile for harbor-exporter built from isityael/harbor.
ARG GO_IMAGE=dhi.io/golang:1.27.1-alpine3.24-dev@sha256:89778e746908997996f8e1de415d9834154eac97a43298ea54bdb74f78116430
ARG RUNTIME_IMAGE=dhi.io/alpine-base:3.24-alpine3.24@sha256:636d7e22a2249d1b7d97a70ea8cf6e8450a1faa5f6a6fa7ef7a0b1312d0353e9

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS builder
ARG GITCOMMIT=unknown
ARG RELEASE_VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /harbor
COPY src/go.mod src/go.sum ./src/
RUN --mount=type=cache,target=/go/pkg/mod cd src && go mod download
COPY src/ ./src/
COPY api/ ./api/
COPY tools/swagger/templates/ ./tools/swagger/templates/

RUN --mount=type=cache,target=/go/pkg/mod go install github.com/go-swagger/go-swagger/cmd/swagger@v0.33.1 \
    && swagger generate server \
    --template-dir=tools/swagger/templates \
    --exclude-main \
    --additional-initialism=CVE \
    --additional-initialism=GC \
    --additional-initialism=OIDC \
    -f api/v2.0/swagger.yaml \
    -A harbor \
    --target src/server/v2.0

RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    cd src && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -mod=mod -o /out/harbor_exporter \
    -ldflags "-w -s \
    -X github.com/goharbor/harbor/src/pkg/version.GitCommit=${GITCOMMIT} \
    -X github.com/goharbor/harbor/src/pkg/version.ReleaseVersion=${RELEASE_VERSION}" \
    ./cmd/exporter

FROM ${RUNTIME_IMAGE}

ENV HARBOR_CA_BUNDLE=/harbor/ca-bundle.crt \
    SSL_CERT_FILE=/harbor/ca-bundle.crt

USER 0
RUN mkdir -p /harbor /etc/harbor/ssl /harbor_cust_cert \
    && cp /etc/ssl/certs/ca-certificates.crt /harbor/ca-bundle.crt \
    && chown -R 10000:10000 /harbor /etc/harbor/ssl /harbor_cust_cert

COPY --from=builder --chown=10000:10000 --chmod=0755 /out/harbor_exporter /harbor/
COPY --chown=10000:10000 --chmod=0755 make/photon/exporter/entrypoint.sh /harbor/
COPY --chown=10000:10000 --chmod=0755 make/photon/common/install_cert.sh /harbor/

WORKDIR /harbor
USER 10000:10000
ENTRYPOINT ["/harbor/entrypoint.sh"]
