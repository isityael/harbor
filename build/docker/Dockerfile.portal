# Multi-stage Dockerfile for harbor-portal built on DHI bases.
ARG NODE_IMAGE=dhi.io/node:26.10.0-debian13-dev@sha256:0556b3ec03bf92b2a499d3615038ce15a922795b8f638aef3b8757507494f154
ARG RUNTIME_IMAGE=dhi.io/nginx:1.31.6-debian13-dev@sha256:1478a971c8696b8a71b748570ba5f3964c8af2a9393c56c6c1d8aa2e9b432d88

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS nodeportal
WORKDIR /build_dir

ARG npm_registry=https://registry.npmjs.org

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-setuptools make g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global --force npm@12.0.1

COPY api/v2.0/swagger.yaml /build_dir/swagger.yaml
COPY src/portal /build_dir

ENV NPM_CONFIG_REGISTRY=${npm_registry}
# The release image never runs Cypress; avoid downloading its browser binary during the build.
ENV CYPRESS_INSTALL_BINARY=0
RUN npm ci
RUN npm run generate-build-timestamp
RUN node --max_old_space_size=2048 'node_modules/@angular/cli/bin/ng' build --configuration production
RUN node -e "const yaml = require('js-yaml'); const fs = require('fs'); const swagger = yaml.load(fs.readFileSync('swagger.yaml', 'utf8')); fs.writeFileSync('swagger.json', JSON.stringify(swagger));"

COPY LICENSE /build_dir/dist

RUN cd app-swagger-ui && npm ci
RUN cd app-swagger-ui && npm run build

FROM ${RUNTIME_IMAGE}

USER 0
RUN apt-get update && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/nginx/logs /var/cache/nginx /var/log/nginx /run \
    && chown -R nginx:nginx /var/lib/nginx /var/cache/nginx /var/log/nginx /run

COPY --from=nodeportal --chown=nginx:nginx /build_dir/dist /usr/share/nginx/html
COPY --from=nodeportal --chown=nginx:nginx /build_dir/swagger.json /usr/share/nginx/html
COPY --from=nodeportal --chown=nginx:nginx /build_dir/app-swagger-ui/dist /usr/share/nginx/html

VOLUME ["/var/cache/nginx", "/var/log/nginx", "/run"]
STOPSIGNAL SIGQUIT

HEALTHCHECK CMD wget -q -O /dev/null http://localhost:8080 || \
    wget --no-check-certificate -q -O /dev/null https://localhost:8443 || exit 1

USER nginx
CMD ["nginx", "-g", "daemon off;"]
