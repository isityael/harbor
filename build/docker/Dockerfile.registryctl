# Multi-stage Dockerfile for harbor-registryctl built on DHI bases.
ARG GO_IMAGE=dhi.io/golang:1.26.4-alpine3.24-dev
ARG RUNTIME_IMAGE=dhi.io/alpine-base:3.24-alpine3.24
ARG DISTRIBUTION_VERSION=v2.8.3-harbor.1-rc.3
ARG DISTRIBUTION_SRC=https://github.com/goharbor/distribution.git

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS distribution-builder
ARG DISTRIBUTION_VERSION
ARG DISTRIBUTION_SRC
ARG TARGETOS=linux
ARG TARGETARCH=amd64

ENV PATH=/usr/local/go/bin:$PATH \
    GO111MODULE=auto \
    BUILDTAGS="include_oss include_gcs"

WORKDIR /go/src/github.com/docker
RUN git clone --depth 1 --branch "${DISTRIBUTION_VERSION}" "${DISTRIBUTION_SRC}" distribution

WORKDIR /go/src/github.com/docker/distribution
RUN go get \
    github.com/gorilla/handlers@v1.5.2 \
    golang.org/x/oauth2/google@v0.36.0 \
    google.golang.org/grpc@v1.81.1 \
    gopkg.in/square/go-jose.v1@v1.0.4 \
    && go mod vendor
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    make PREFIX=/go clean bin/registry

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS builder
ARG GITCOMMIT=unknown
ARG RELEASE_VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /harbor
COPY src/ ./src/
COPY api/ ./api/
COPY tools/swagger/templates/ ./tools/swagger/templates/

RUN go install github.com/go-swagger/go-swagger/cmd/swagger@v0.33.1 \
    && swagger generate server \
    --template-dir=tools/swagger/templates \
    --exclude-main \
    --additional-initialism=CVE \
    --additional-initialism=GC \
    --additional-initialism=OIDC \
    -f api/v2.0/swagger.yaml \
    -A harbor \
    --target src/server/v2.0

RUN cd src && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -mod=mod -o /out/harbor_registryctl \
    -ldflags "-w -s \
    -X github.com/goharbor/harbor/src/pkg/version.GitCommit=${GITCOMMIT} \
    -X github.com/goharbor/harbor/src/pkg/version.ReleaseVersion=${RELEASE_VERSION}" \
    ./registryctl

FROM ${RUNTIME_IMAGE}

ENV HARBOR_CA_BUNDLE=/home/harbor/ca-bundle.crt \
    SSL_CERT_FILE=/home/harbor/ca-bundle.crt

RUN mkdir -p /home/harbor /etc/registry /etc/registryctl /var/lib/registry /etc/harbor/ssl /harbor_cust_cert \
    && cp /etc/ssl/certs/ca-certificates.crt /home/harbor/ca-bundle.crt \
    && chown -R 10000:10000 /home/harbor /etc/registry /etc/registryctl /var/lib/registry /etc/harbor/ssl /harbor_cust_cert

COPY --from=builder --chown=10000:10000 --chmod=0755 /out/harbor_registryctl /home/harbor/
COPY --from=distribution-builder --chown=10000:10000 --chmod=0755 /go/src/github.com/docker/distribution/bin/registry /usr/bin/registry_DO_NOT_USE_GC
COPY --chown=10000:10000 --chmod=0755 make/photon/registryctl/start.sh /home/harbor/
COPY --chown=10000:10000 --chmod=0755 make/photon/common/install_cert.sh /home/harbor/

HEALTHCHECK --interval=30s --timeout=10s \
    CMD wget -q -O /dev/null http://localhost:8080/api/health || exit 1

VOLUME ["/var/lib/registry"]
ENTRYPOINT ["/home/harbor/start.sh"]
USER 10000:10000
